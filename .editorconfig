# Root EditorConfig file
root = true

# ==============================
# General
# ==============================
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
spelling_language = en

# ==============================
# Markdown
# ==============================
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ==============================
# Makefile
# ==============================
[{Makefile,*.mk}]
indent_style = tab
indent_size = tab

# ==============================
# Python
# ==============================
[*.py]
indent_size = 4
max_line_length = 88

# ==============================
# Shell / Dockerfile
# ==============================
[{*.sh,*.bash,*.zsh,Dockerfile,*.dockerfile}]
indent_size = 2

# ==============================
# Lock file
# ==============================
[{*.min.js,*.min.css,*.map,package-lock.json,pnpm-lock.yaml,yarn.lock}]
insert_final_newline = false
trim_trailing_whitespace = false

# ==============================
# YAML
# ==============================
[*.{yml,yaml}]
indent_size = 2

# ==============================
# JSON
# ==============================
[*.json]
indent_size = 2

# ==============================
# HTML / CSS / JS / TS
# ==============================
[*.{html,htm}]
indent_size = 2

[*.{css,scss,sass,less}]
indent_size = 2

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}]
indent_size = 2
max_line_length = 100
